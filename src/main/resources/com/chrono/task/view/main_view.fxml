<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.web.WebView?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chrono.task.controller.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar">
            <children>
                <Label fx:id="activeTaskLabel" text="No Active Task" styleClass="active-task" minWidth="0"
                       HBox.hgrow="SOMETIMES"/>
                <Button fx:id="locateTaskButton" mnemonicParsing="false" onAction="#onLocateActiveTask"
                        disable="true" styleClass="icon-button, locate-task-button" minWidth="-Infinity">
                    <graphic>
                        <!-- target icon: concentric rings drawn with the even-odd fill rule -->
                        <SVGPath styleClass="locate-task-icon" fillRule="EVEN_ODD"
                                 content="M 0 8 A 8 8 0 1 0 16 8 A 8 8 0 1 0 0 8 Z M 1.8 8 A 6.2 6.2 0 1 0 14.2 8 A 6.2 6.2 0 1 0 1.8 8 Z M 3.8 8 A 4.2 4.2 0 1 0 12.2 8 A 4.2 4.2 0 1 0 3.8 8 Z M 5.8 8 A 2.2 2.2 0 1 0 10.2 8 A 2.2 2.2 0 1 0 5.8 8 Z"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Select the current task in the list"/>
                    </tooltip>
                </Button>
                <Label fx:id="todayTimerLabel" text="-" styleClass="timer-today" minWidth="-Infinity"/>
                <Label fx:id="monthTimerLabel" text="-" styleClass="timer-secondary" minWidth="-Infinity"/>
                <Label fx:id="activeTimerLabel" text="-" styleClass="timer-secondary" minWidth="-Infinity"/>
                <Label fx:id="totalDailyLabel" text="-" styleClass="timer-secondary, timer-total" minWidth="-Infinity"/>
                <Button fx:id="pauseButton" mnemonicParsing="false" onAction="#onTogglePause" text="Pause"
                        disable="true" styleClass="pause-button" minWidth="-Infinity"/>
            </children>
        </HBox>
    </top>
    <center>
        <!-- Terminal panel (Ctrl+F12) is added as a 2nd item by MainController.toggleTerminal() -->
        <SplitPane fx:id="mainSplitPane" orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">
                    <tabs>
                        <Tab fx:id="workTab" text="Work">
                            <content>
                                <SplitPane dividerPositions="0.3">
                                    <items>
                                        <VBox spacing="10.0" styleClass="side-panel">
                                            <children>
                                                <HBox HBox.hgrow="ALWAYS" spacing="4.0" alignment="CENTER_LEFT">
                                                    <TextField fx:id="filterField" promptText="🔍  Filter tasks..." HBox.hgrow="ALWAYS"
                                                               styleClass="search-field"/>
                                                    <Button mnemonicParsing="false" styleClass="icon-button"
                                                            onAction="#clearFilter" text="X"/>
                                                </HBox>
                                                <CheckBox fx:id="showDoneTasksCheckbox" text="Show completed tasks"/>
                                                <ListView fx:id="taskListView" VBox.vgrow="ALWAYS" styleClass="task-list"/>
                                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                                        onAction="#onAddTask" text="＋  Add New Task" styleClass="accent, add-task-button"/>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                            </padding>
                                        </VBox>
                                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" styleClass="detail-panel">
                                            <children>
                                                <TextField fx:id="descriptionField" promptText="Task Description"
                                                           HBox.hgrow="ALWAYS" styleClass="title-field"/>
                                                <HBox spacing="5.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="jiraUrlField" promptText="Jira URL"
                                                                   HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="copyJiraUrlButton" mnemonicParsing="false"
                                                                onAction="#onCopyJiraUrl" text="📋" minWidth="35.0" styleClass="icon-button"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="5.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="slackUrlField" promptText="Slack URL"
                                                                   HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="copySlackUrlButton" mnemonicParsing="false"
                                                                onAction="#onCopySlackUrl" text="📋" minWidth="35.0" styleClass="icon-button"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Adjust Time (min):" styleClass="field-label"/>
                                                        <TextField fx:id="timeAdjustmentField" prefWidth="80.0"
                                                                   promptText="min"/>
                                                        <Button mnemonicParsing="false" onAction="#onAdjustTime" text="Apply" styleClass="accent"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Status:" styleClass="field-label"/>
                                                        <ComboBox fx:id="statusComboBox" prefWidth="150.0"/>
                                                    </children>
                                                </HBox>
                                                <Label text="NOTES (MARKDOWN)" styleClass="section-label"/>
                                                <SplitPane dividerPositions="0.15,0.20" orientation="VERTICAL"
                                                           VBox.vgrow="ALWAYS" styleClass="notes-split">
                                                    <items>
                                                        <TextArea fx:id="dailyNoteArea" promptText="Daily note for today..."
                                                                  maxHeight="150"/>
                                                        <TextArea fx:id="markdownEditor" promptText="Type markdown here..." styleClass="mono"/>
                                                        <WebView fx:id="markdownPreview"/>
                                                    </items>
                                                </SplitPane>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                            </padding>
                                        </VBox>
                                    </items>
                                </SplitPane>
                            </content>
                        </Tab>
                        <Tab text="History">
                            <content>
                                <VBox spacing="16.0" styleClass="page">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-card">
                                            <children>
                                                <javafx.scene.control.CheckBox fx:id="historyRangeCheckbox"
                                                                               text="Range selection"/>
                                                <Label text="Start:" styleClass="field-label"/>
                                                <DatePicker fx:id="historyDatePicker" prefWidth="120.0"/>
                                                <DatePicker fx:id="historyEndDatePicker" prefWidth="120.0"
                                                            visible="${historyRangeCheckbox.selected}"
                                                            managed="${historyRangeCheckbox.selected}"/>
                                                <Button onAction="#onRefreshHistory" text="↻  Refresh" styleClass="accent"/>
                                                <javafx.scene.control.CheckBox fx:id="historyDurationCheckbox"
                                                                               text="with duration" selected="true"/>
                                                <javafx.scene.control.CheckBox fx:id="historyDailyNoteCheckbox"
                                                                               text="Include daily note"/>
                                            </children>
                                        </HBox>
                                        <TextArea fx:id="historyTextArea" editable="false" prefHeight="200.0" prefWidth="200.0"
                                                  VBox.vgrow="ALWAYS" styleClass="mono"/>
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                    </padding>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab text="Settings">
                            <content>
                                <ScrollPane fitToWidth="true" styleClass="settings-scroll">
                                <VBox spacing="16.0" styleClass="page">
                                    <children>
                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label text="Data" styleClass="section-title"/>
                                                <Label text="Data Storage Path:" styleClass="field-label"/>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="dataStoragePathField" HBox.hgrow="ALWAYS" editable="false"/>
                                                        <Button mnemonicParsing="false" onAction="#onBrowseDataPath" text="Browse..."/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label text="Git Backup" styleClass="section-title"/>
                                                <CheckBox fx:id="gitBackupEnabledCheckbox" text="Enable Git Backup"/>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Backup Every:" styleClass="field-label"/>
                                                        <TextField fx:id="gitBackupIntervalField" prefWidth="60.0" promptText="1"/>
                                                        <ComboBox fx:id="gitBackupUnitComboBox"/>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="gitStatusLabel" styleClass="error-label" visible="false"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label text="Jira" styleClass="section-title"/>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <CheckBox fx:id="jiraRefreshEnabledCheckbox" text="Enable Jira Auto-Refresh"/>
                                                        <Label text="Refresh Every:" styleClass="field-label">
                                                            <HBox.margin>
                                                                <Insets left="20.0"/>
                                                            </HBox.margin>
                                                        </Label>
                                                        <TextField fx:id="jiraRefreshIntervalField" prefWidth="60.0" promptText="15"/>
                                                        <ComboBox fx:id="jiraRefreshUnitComboBox"/>
                                                    </children>
                                                </HBox>
                                                <Label text="Jira Base URL:" styleClass="field-label"/>
                                                <TextField fx:id="jiraBaseUrlField" promptText="e.g., https://yourcompany.atlassian.net"/>
                                                <Label text="Jira Email:" styleClass="field-label"/>
                                                <TextField fx:id="jiraEmailField" promptText="Enter Jira Email"/>
                                                <Label text="Jira API Token:" styleClass="field-label"/>
                                                <HBox spacing="5.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <PasswordField fx:id="jiraApiTokenField"
                                                                       promptText="Enter Jira API Token" HBox.hgrow="ALWAYS"/>
                                                        <TextField fx:id="jiraApiTokenVisibleField"
                                                                   promptText="Enter Jira API Token" visible="false"
                                                                   managed="false" HBox.hgrow="ALWAYS"/>
                                                        <ToggleButton fx:id="tokenVisibilityToggle" text="👁"/>
                                                    </children>
                                                </HBox>
                                                <Label text="JQL Query for Auto-Creation:" styleClass="field-label"/>
                                                <TextField fx:id="jqlQueryField" promptText="Enter JQL query (e.g., assignee = currentUser() AND status != Done)"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label text="Appearance" styleClass="section-title"/>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Theme:" styleClass="field-label"/>
                                                        <ComboBox fx:id="uiThemeComboBox" prefWidth="120.0"/>
                                                        <Label text="Markdown Font:" styleClass="field-label">
                                                            <HBox.margin>
                                                                <Insets left="20.0"/>
                                                            </HBox.margin>
                                                        </Label>
                                                        <ComboBox fx:id="markdownFontComboBox" prefWidth="250.0"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label text="Terminal (Ctrl+F12)" styleClass="section-title"/>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Shell:" styleClass="field-label"/>
                                                        <TextField fx:id="terminalShellField" prefWidth="200.0" promptText="Default ($SHELL)"/>
                                                        <Label text="Start directory:" styleClass="field-label"/>
                                                        <TextField fx:id="terminalStartDirectoryField" HBox.hgrow="ALWAYS" promptText="Home directory"/>
                                                        <Button mnemonicParsing="false" onAction="#onBrowseTerminalStartDirectory" text="Browse..."/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Theme:" styleClass="field-label"/>
                                                        <ComboBox fx:id="terminalThemeComboBox" prefWidth="100.0"/>
                                                        <Label text="Font:" styleClass="field-label"/>
                                                        <ComboBox fx:id="terminalFontComboBox" prefWidth="200.0" promptText="Default"/>
                                                        <Label text="Size:" styleClass="field-label"/>
                                                        <TextField fx:id="terminalFontSizeField" prefWidth="50.0" promptText="14"/>
                                                        <Label text="Scrollback lines:" styleClass="field-label"/>
                                                        <TextField fx:id="terminalScrollbackField" prefWidth="70.0" promptText="5000"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="16.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <CheckBox fx:id="terminalCopyOnSelectCheckbox" text="Copy on select"/>
                                                        <CheckBox fx:id="terminalCtrlCCopiesCheckbox" text="Ctrl+C copies the selection"/>
                                                        <CheckBox fx:id="terminalCtrlVPastesCheckbox" text="Ctrl+V pastes"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <Button mnemonicParsing="false" onAction="#onSaveSettings" text="💾  Save Settings"
                                                styleClass="accent" defaultButton="false"/>
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                    </padding>
                                </VBox>
                                </ScrollPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <children>
                <HBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="jiraUpdateLabel" text="⟳ Updating Jira's status..." styleClass="jira-update"
                               visible="false" managed="false"/>
                    </children>
                </HBox>
                <Label fx:id="lastSaveLabel" text="Last save: -"/>
                <Label fx:id="lastCommitLabel" text="Last commit: -"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
